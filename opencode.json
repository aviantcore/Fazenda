{
    "$schema": "https://opencode.ai/config.json",
    "provider": {
        "amazon-bedrock": {
            "options": {
                "accessKeyId": "{env:AWS_ACCESS_KEY_ID}",
                "secretAccessKey": "{env:AWS_SECRET_ACCESS_KEY}",
                "region": "us-east-1"
            }
        },
        "openrouter": {
            "options": {
                "baseURL": "https://openrouter.ai/api/v1",
                "apiKey": "{env:OPENROUTER_API_KEY}"
            }
        }
    }
}